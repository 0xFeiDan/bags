# Docker Compose reads this file only after you copy it to .env.
POSTGRES_DB=bags
POSTGRES_USER=bags
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://bags:change-me-before-production@postgres:5432/bags
REDIS_URL=redis://redis:6379/0
APP_ENV=development
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
AUTH_SESSION_COOKIE_NAME=bags_session
AUTH_CSRF_COOKIE_NAME=bags_csrf
AUTH_SESSION_DAYS=7
AUTH_REMEMBER_DAYS=30
AUTH_LOGIN_CHALLENGE_MINUTES=5
AUTH_SENSITIVE_MINUTES=10
AUTH_TOTP_ISSUER=Bags
# Keep false for local HTTP only. Production also forces Secure cookies when APP_ENV=production.
AUTH_COOKIE_SECURE=false
# This personal-ledger V1 has exactly one administrator. It cannot be enabled for multiple users.
AUTH_ALLOW_ADDITIONAL_REGISTRATION=false
# Required exactly once to initialize the administrator. Send it in X-Bootstrap-Token,
# then remove it from .env and restart the API after the account exists.
AUTH_BOOTSTRAP_TOKEN=
# Docker binds the API here. Keep 127.0.0.1 and expose it only through an HTTPS reverse proxy.
BAGS_API_BIND=127.0.0.1
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
AUTH_TRUST_PROXY_HEADERS=false
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit a real value. API credentials cannot be saved until this is set.
MASTER_ENCRYPTION_KEY=
# Optional overrides for compatible Binance endpoints or test environments.
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_USDM_BASE_URL=https://fapi.binance.com
BINANCE_COINM_BASE_URL=https://dapi.binance.com
# Phase 8 CEX endpoints. Keep official domains unless using a controlled test environment.
BYBIT_BASE_URL=https://api.bybit.com
BITGET_BASE_URL=https://api.bitget.com
# Hyperliquid public read-only info API. No wallet private key is required.
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
# Phase 4 EVM wallets. Configure only the chains you use; never place a private key here.
EVM_ETHEREUM_RPC_URL=
EVM_ARBITRUM_RPC_URL=
EVM_BASE_RPC_URL=
EVM_BSC_RPC_URL=
EVM_OPTIMISM_RPC_URL=
EVM_POLYGON_RPC_URL=
EVM_REQUEST_TIMEOUT_SECONDS=15
EVM_MAX_RETRIES=3
# ERC-20 logs are split into bounded ranges. Failed ranges stay visible and do not advance the cursor.
EVM_LOG_CHUNK_SIZE=5000
EVM_DEFAULT_LOOKBACK_BLOCKS=2000
EVM_MAX_BLOCK_SPAN=500000
# Standard JSON-RPC has no address-history endpoint. Native-only history is scanned within this bound.
EVM_NATIVE_SCAN_MAX_BLOCKS=2000
# Per-wallet cap for token balance calls. Excess discovered contracts remain visible in raw evidence for a later bounded backfill.
EVM_MAX_TOKEN_CONTRACTS=250
EVM_CONFIRMATIONS=12
# Zerion is an optional read-only chain data source. Leave it disabled until
# Phase 2; Phase 1 never sends a Zerion request. Defaults follow the live demo
# response observed on 2026-08-23: 1 request/second and 300 requests/day. Each
# run uses at most three requests and the daily budget reserves 10% for checks.
ZERION_ENABLED=false
ZERION_API_KEY=
ZERION_BASE_URL=https://api.zerion.io
ZERION_REQUEST_TIMEOUT_SECONDS=20
ZERION_MAX_RETRIES=0
ZERION_REQUESTS_PER_SECOND_LIMIT=1
ZERION_DAILY_REQUEST_LIMIT=300
ZERION_MAX_REQUESTS_PER_RUN=3
ZERION_MIN_SYNC_INTERVAL_SECONDS=900
# Reserve 30 requests for manual diagnostics and delayed quota accounting.
ZERION_DAILY_REQUEST_BUDGET=270
# Phase 5 transfer matching thresholds.
TRANSFER_MATCH_WINDOW_HOURS=72
TRANSFER_EXACT_HASH_WINDOW_DAYS=30
TRANSFER_AMOUNT_CANDIDATE_TOLERANCE=0.05
TRANSFER_AMOUNT_CLOSE_TOLERANCE=0.001
TRANSFER_TIME_CLOSE_MINUTES=30
TRANSFER_AUTO_SCORE=90
TRANSFER_REVIEW_SCORE=70
TRANSFER_MATCH_MAX_EVENTS=10000
